<Window x:Class="TaskbarLyrics.YearReportWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务栏歌词 - 年度听歌报告" Width="580" Height="820" MinWidth="580" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <!-- 顶上一排工具栏（选年份、存图片、复制），下面是一张竖版海报。
         「保存为图片」「复制图片」画的就是 Poster 这一块：只有统计数字和歌名，没有路径、用户名 -->
    <Window.Resources>
        <ResourceDictionary Source="StatsResources.xaml"/>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Margin="28,18,28,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="YearBox" MinWidth="110" VerticalAlignment="Center" ItemStringFormat="{}{0} 年"
                      SelectionChanged="Year_Changed"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource RowDesc}" Margin="14,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="SaveButton" Padding="12,5" VerticalAlignment="Center" Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;"/>
                        <TextBlock Text="保存为图片…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton" Padding="12,5" Margin="8,0,0,0" VerticalAlignment="Center" Click="Copy_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8C8;"/>
                        <TextBlock Text="复制图片" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,8,28,28">
                <!-- 这一年没有记录 -->
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,80,0,0">
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="EmptyText" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,14,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="换个年份看看吧。" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- 海报 -->
                <Border x:Name="Poster" Width="460" HorizontalAlignment="Center" VerticalAlignment="Top"
                        CornerRadius="12" Padding="28,28,28,18" BorderThickness="1" Visibility="Collapsed"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock x:Name="YearText" FontSize="48" FontWeight="SemiBold" LineHeight="52"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="年度听歌报告" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="RangeText" Style="{StaticResource RowDesc}"/>

                        <!-- 总时长 -->
                        <TextBlock Text="这一年一共听了" Style="{StaticResource RowDesc}" Margin="0,24,0,0"/>
                        <TextBlock x:Name="TotalText" FontSize="32" FontWeight="SemiBold" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="CountsText" Style="{StaticResource RowDesc}" Margin="0,4,0,0"/>

                        <!-- 年度之歌：强调色底的一张卡。有封面时左边放封面，底换成同一张图放大模糊、再压一层黑，
                             字一律白色（强调色上的字在深色主题里是黑的，压在暗底上看不清） -->
                        <Border x:Name="SongOfYear" CornerRadius="8" Margin="0,22,0,0"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <Grid>
                                <!-- 圆角裁切在代码里按尺寸设：Border 的圆角不裁子元素。
                                     模糊底用画刷不用 Image：Image 按图片比例参与测量，会把卡片撑成方块 -->
                                <Grid x:Name="SongOfYearBackdrop" Visibility="Collapsed">
                                    <Border Margin="-40">
                                        <Border.Background>
                                            <ImageBrush x:Name="SongOfYearBlur" Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <Border.Effect>
                                            <BlurEffect Radius="40"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border Background="#73000000"/>
                                </Grid>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SongOfYearCover" Width="88" Height="88" CornerRadius="6" Margin="0,0,16,0"
                                            Visibility="Collapsed">
                                        <Border.Background>
                                            <ImageBrush x:Name="SongOfYearCoverBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="SongOfYearLabel" Text="年度之歌" FontSize="12" Opacity="0.8"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        <TextBlock x:Name="SongOfYearTitle" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        <TextBlock x:Name="SongOfYearSub" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 前五名 -->
                        <TextBlock Style="{StaticResource PanelTitle}" Text="最常听的歌" Margin="0,24,0,4"/>
                        <ItemsControl x:Name="SongList" ItemTemplate="{StaticResource RankTemplate}"/>
                        <TextBlock Style="{StaticResource PanelTitle}" Text="最常听的歌手" Margin="0,20,0,4"/>
                        <ItemsControl x:Name="ArtistList" ItemTemplate="{StaticResource RankTemplate}"/>
                        <!-- 这年的记录里完全没有专辑信息（旧版本记的）时整段收起，海报上不放一张空榜 -->
                        <StackPanel x:Name="AlbumSection">
                            <TextBlock Style="{StaticResource PanelTitle}" Text="最常听的专辑" Margin="0,20,0,4"/>
                            <ItemsControl x:Name="AlbumList" ItemTemplate="{StaticResource RankTemplate}"/>
                            <TextBlock x:Name="AlbumNote" Style="{StaticResource PanelNote}"/>
                        </StackPanel>

                        <!-- 12 个月 -->
                        <TextBlock Style="{StaticResource PanelTitle}" Text="每个月听了多久" Margin="0,24,0,14"/>
                        <ItemsControl x:Name="MonthChart" ItemsPanel="{StaticResource BarPanel}"
                                      ItemTemplate="{StaticResource BarTemplate}"/>

                        <!-- 听歌习惯 -->
                        <StackPanel x:Name="HabitSection">
                            <TextBlock Style="{StaticResource PanelTitle}" Text="听歌习惯" Margin="0,24,0,0"/>
                            <TextBlock x:Name="PeakText" Style="{StaticResource RowDesc}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="HeatText" Style="{StaticResource PanelNote}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 亮点 -->
                        <ItemsControl x:Name="HighlightList" Margin="-5,18,-5,0" ItemTemplate="{StaticResource FactTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- 落款 -->
                        <Border Height="1" Margin="0,18,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                        <TextBlock Text="任务栏歌词 · 听歌统计" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
