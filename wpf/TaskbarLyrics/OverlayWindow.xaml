<Window x:Class="TaskbarLyrics.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Visibility="Hidden" SizeToContent="Manual" Width="560" Height="40">
    <Window.Resources>
        <!-- 播放控制按钮：透明底，悬停浅色圆角背景（对应 render.py HOVER_FILL），
             字形用 Segoe MDL2 Assets -->
        <Style x:Key="CtrlButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14.67"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Margin="2,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#16FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- 清晰度：分层（透明）窗口默认回退灰阶抗锯齿会发虚，
         ClearTypeHint 强制 ClearType（背景为不透明的任务栏，不会产生色边），
         TextFormattingMode=Display + UseLayoutRounding 让文字对齐物理像素 -->
        <Grid x:Name="Root"
          TextOptions.TextFormattingMode="Display"
          RenderOptions.ClearTypeHint="Enabled"
          UseLayoutRounding="True">
        <!-- 浮动模式底色：半透明深色圆角底（仅浮动模式显示），
             遮住分层窗逐帧重绘的闪烁感，也让整个条可拖动（不再只能抓文字） -->
        <Border x:Name="FloatBg" CornerRadius="8" Background="#B3222226"
                Margin="1" Visibility="Collapsed"/>
        <!-- 悬停遮罩：淡白圆角底（对标 Win11 任务栏图标悬停），
             Margin 内缩，范围略小于任务栏高度，平时透明 -->
        <Border x:Name="HoverMask" Background="#17FFFFFF" CornerRadius="6"
                Margin="2,4" Opacity="0" IsHitTestVisible="False"
                HorizontalAlignment="Left"/>
        <!-- 封面区：占位底（无封面时显示音符占位）+ 封面图（有封面时盖住占位） -->
        <Grid x:Name="CoverZone" HorizontalAlignment="Left" VerticalAlignment="Center"
              Margin="6,0,0,0" Visibility="Collapsed">
            <Rectangle RadiusX="4" RadiusY="4" Fill="#2EFFFFFF"/>
            <TextBlock Text="&#xE189;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                       Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Rectangle x:Name="CoverRect" RadiusX="4" RadiusY="4"/>
        </Grid>
        <!-- 主体区：按钮列（宿主宽度可动画，悬停时 0→96 展开，内容随之平滑右移）+ 内容列 -->
        <Grid x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ButtonsHost" Grid.Column="0" Width="0"
                    ClipToBounds="True" VerticalAlignment="Stretch">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Width="96"
                            VerticalAlignment="Stretch" Opacity="0" IsHitTestVisible="False">
                    <Button x:Name="BtnPrev" Style="{StaticResource CtrlButton}" Content="&#xE892;" Click="BtnPrev_Click"/>
                    <Button x:Name="BtnPlayPause" Style="{StaticResource CtrlButton}" Content="&#xE768;" Click="BtnPlayPause_Click"/>
                    <Button x:Name="BtnNext" Style="{StaticResource CtrlButton}" Content="&#xE893;" Click="BtnNext_Click"/>
                </StackPanel>
            </Border>
            <Grid x:Name="ContentArea" Grid.Column="1" ClipToBounds="True">
                <!-- 歌词行容器：切行时新旧两行在此叠加做滑动淡入淡出；
                     ClipToBounds 供超长歌词滚动裁剪 -->
                <Grid x:Name="LinesHost" VerticalAlignment="Center" ClipToBounds="True"/>
                <!-- 歌曲信息层：悬停或暂停一段时间后代替歌词显示（上行歌名、下行歌手） -->
                <StackPanel x:Name="InfoPanel" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="TitleText" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
