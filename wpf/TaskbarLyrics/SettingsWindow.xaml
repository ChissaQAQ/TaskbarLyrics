<Window x:Class="TaskbarLyrics.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务栏歌词 - 设置" Width="480" Height="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True">
    <!-- 背景/控件样式交给 App.xaml 的 Fluent 主题（Win11 风格，跟随系统明暗） -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0">
            <!-- 通用 -->
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="显示模式" Width="90" VerticalAlignment="Center"/>
                        <RadioButton x:Name="ModeTaskbar" Content="任务栏模式" GroupName="mode" Margin="0,0,12,0"/>
                        <RadioButton x:Name="ModeFloating" Content="浮动模式" GroupName="mode"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="显示器" Width="90" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MonitorBox" Width="240" IsEditable="False"/>
                    </StackPanel>
                    <CheckBox x:Name="LockedCheck" Content="锁定位置（鼠标穿透，托盘菜单解锁）" Margin="0,4"/>
                    <CheckBox x:Name="HideFullscreenCheck" Content="全屏应用在前台时自动隐藏" Margin="0,4"/>
                    <CheckBox x:Name="AutostartCheck" Content="开机自启" Margin="0,4"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- 歌词 -->
            <TabItem Header="歌词">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="第二行" Width="90" VerticalAlignment="Center"/>
                        <RadioButton x:Name="SecondTranslation" Content="译文" GroupName="second" Margin="0,0,12,0"/>
                        <RadioButton x:Name="SecondRomaji" Content="罗马音" GroupName="second" Margin="0,0,12,0"/>
                        <RadioButton x:Name="SecondOff" Content="关闭" GroupName="second"/>
                    </StackPanel>
                    <CheckBox x:Name="KaraokeCheck" Content="逐字歌词（卡拉 OK 扫过）" Margin="0,4"/>
                    <CheckBox x:Name="ShowCoverCheck" Content="显示专辑封面" Margin="0,4"/>
                    <CheckBox x:Name="ShowControlsCheck" Content="悬停显示播放控制按钮" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="歌词偏移（秒）" Width="90" VerticalAlignment="Center"/>
                        <TextBox x:Name="OffsetBox" Width="60" Text="0"/>
                        <TextBlock Text="（-3 ~ 3，提前为负）" VerticalAlignment="Center" Foreground="Gray" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="播放器来源" Width="90" VerticalAlignment="Center"/>
                        <RadioButton x:Name="SourceAuto" Content="自动（优先网易云）" GroupName="source" Margin="0,0,12,0"/>
                        <RadioButton x:Name="SourceNetease" Content="仅网易云音乐" GroupName="source" Margin="0,0,12,0"/>
                        <RadioButton x:Name="SourceOthers" Content="仅其他播放器" GroupName="source"/>
                    </StackPanel>
                    <Button x:Name="BlockButton" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Padding="10,4" Click="BlockButton_Click"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- 外观 -->
            <TabItem Header="外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="字体" Width="90" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FontBox" Width="240" IsEditable="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="字号" Width="90" VerticalAlignment="Center"/>
                        <TextBox x:Name="FontSizeBox" Width="60"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="文字对齐" Width="90" VerticalAlignment="Center"/>
                        <RadioButton x:Name="AlignCenter" Content="居中" GroupName="align" Margin="0,0,12,0"/>
                        <RadioButton x:Name="AlignLeft" Content="左对齐（配封面更整齐）" GroupName="align"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="最大宽度" Width="90" VerticalAlignment="Center"/>
                        <ComboBox x:Name="WidthBox" Width="80" IsEditable="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="原文颜色" Width="90" VerticalAlignment="Center"/>
                        <TextBox x:Name="TextColorBox" Width="80" TextChanged="ColorBox_TextChanged"/>
                        <Border x:Name="TextColorSwatch" Width="24" Height="18" Margin="8,0,0,0"
                                BorderBrush="Gray" BorderThickness="1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="译文颜色" Width="90" VerticalAlignment="Center"/>
                        <TextBox x:Name="TransColorBox" Width="80" TextChanged="ColorBox_TextChanged"/>
                        <Border x:Name="TransColorSwatch" Width="24" Height="18" Margin="8,0,0,0"
                                BorderBrush="Gray" BorderThickness="1"/>
                    </StackPanel>
                    <CheckBox x:Name="ShadowCheck" Content="文字阴影" Margin="0,4"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="确定" Width="72" Margin="8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="应用" Width="72" Margin="8,0" Click="Apply_Click"/>
            <Button Content="取消" Width="72" Margin="8,0" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
