<Window x:Class="TaskbarLyrics.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务栏歌词 - 设置" Width="820" Height="660" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <!-- Win11 设置风格：左侧导航 + 卡片式分组；行 = 标题+说明（左）/ 控件（右）。
         多选项统一用下拉框（不会再横向溢出），布尔项用开关（ToggleSwitch）。
         背景/控件样式交给 App.xaml 的 Fluent 主题（跟随系统明暗）。 -->
    <Window.Resources>
        <!-- 配色一律取 Fluent 主题自带的自适应资源（TextFillColor* / *FillColor* / *StrokeColor*），
             它们随 ThemeMode 明暗切换。这里绝不能用 SystemColors.*：那是 Win32 经典系统色，
             实测在 Light/Dark 下取值完全相同（WindowBrush 恒白、ControlTextBrush 恒黑、
             GrayTextBrush 恒灰），跟 Fluent 的明暗一混用就会出现白字白底、深字深底。 -->

        <!-- Win11 式下拉项：圆角药丸悬停 + 选中对勾（而非左侧竖条） -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBg" CornerRadius="4" Margin="1"
                                Background="Transparent" Padding="8,0">
                            <Grid MinHeight="28">
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center" Visibility="Collapsed"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <ContentPresenter Margin="22,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win11 式下拉框：圆角边框 + 字形箭头；弹出层 8px 圆角 + 柔和阴影 + 淡入动画。
             模板含 PART_EditableTextBox，可编辑下拉框（字体/最大宽度）行为不变 -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" ClickMode="Press" Focusable="False"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" CornerRadius="4" BorderThickness="1"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="11,0,30,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}"
                                     Background="Transparent" BorderThickness="0"
                                     Margin="0,0,30,0" Padding="11,0,0,0" VerticalContentAlignment="Center"
                                     HorizontalAlignment="Stretch" Visibility="Collapsed"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                                <Border CornerRadius="8" Padding="5,4"
                                        Background="{DynamicResource ControlSolidFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.22"
                                                          Color="Black" Direction="270"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                                  Focusable="False">
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win11 式导航项：圆角填充 + 选中时左侧 accent 小竖条 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="5" Background="Transparent">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Visibility="Collapsed"/>
                                <ContentPresenter Margin="10,7"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win11 式开关：滑块位移动画 + 强调色轨道 -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X"
                                                             To="22" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Track" CornerRadius="11" BorderThickness="1"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0,0,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobX" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片容器 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        </Style>
        <!-- 设置行：左标题+说明，右控件 -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,9"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>
        <Style x:Key="PageHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,16"/>
        </Style>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="220"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- 预设色块：Tag 里放 hex，点一下填进旁边的输入框。
             自己写模板而不是用默认 Button：默认模板会把自己的背景画在最外层，
             色块的颜色就看不见了 -->
        <Style x:Key="ColorChip" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="4" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Chip" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Padding="8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="10,10,10,14">
                        <TextBlock Text="任务栏歌词" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="设置" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ListBox x:Name="NavList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Width="26" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

            <!-- 内容页 -->
            <ScrollViewer x:Name="PageScroller" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Padding="28,18,28,8">
                <StackPanel>
                    <!-- 通用 -->
                    <StackPanel x:Name="PageGeneral" Visibility="Visible">
                        <TextBlock Style="{StaticResource PageHeader}" Text="通用"/>
                        <TextBlock Style="{StaticResource CardHeader}" Text="显示"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="显示模式"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="嵌入任务栏，或作为独立的置顶悬浮窗"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ModeCombo" Grid.Column="1" Style="{StaticResource RowCombo}">
                                        <ComboBoxItem Content="任务栏模式"/>
                                        <ComboBoxItem Content="浮动模式"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="显示器"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="在哪块屏幕的任务栏上显示歌词"/>
                                    </StackPanel>
                                    <ComboBox x:Name="MonitorCombo" Grid.Column="1" Style="{StaticResource RowCombo}"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="自动避让任务栏元素"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="自动停靠在任务栏空档里，宽度随可用空间伸缩，永不与图标托盘重叠（开启后任务栏内拖动停用，仅任务栏模式生效）"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="AutoPositionSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="避让停靠侧"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="自动避让时优先停靠在任务栏的哪半边；空间恢复后会自动回到这边"/>
                                    </StackPanel>
                                    <ComboBox x:Name="AutoSideCombo" Grid.Column="1" Style="{StaticResource RowCombo}">
                                        <ComboBoxItem Content="右半边"/>
                                        <ComboBoxItem Content="左半边"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="停靠对齐"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="窗口在空档内的停靠位置；左对齐贴图标侧，悬停展开按钮时不推图标"/>
                                    </StackPanel>
                                    <ComboBox x:Name="AutoAlignCombo" Grid.Column="1" Style="{StaticResource RowCombo}">
                                        <ComboBoxItem Content="左对齐"/>
                                        <ComboBoxItem Content="右对齐"/>
                                        <ComboBoxItem Content="居中"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="全屏时自动隐藏"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="全屏应用（如游戏）在前台且与歌词同屏时隐藏"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="HideFullscreenSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CardHeader}" Text="行为"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="锁定位置"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="锁定后鼠标穿透、不可拖动，可在托盘菜单解锁"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="LockedSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="开机自启"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="登录 Windows 后自动启动"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="AutostartSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CardHeader}" Text="更新"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="当前版本"/>
                                    </StackPanel>
                                    <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="自动检查更新"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="启动时自动检查新版本，发现后右键菜单出现更新入口"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="UpdateCheckSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="检查更新"/>
                                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowDesc}" Text=""/>
                                    </StackPanel>
                                    <Button x:Name="UpdateButton" Grid.Column="1" Content="检查更新"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Padding="12,5" Click="UpdateButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 歌词 -->
                    <StackPanel x:Name="PageLyrics" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageHeader}" Text="歌词"/>
                        <TextBlock Style="{StaticResource CardHeader}" Text="内容"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="第二行"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="优先显示译文；无译文时自动显示下一句"/>
                                    </StackPanel>
                                    <ComboBox x:Name="SecondLineCombo" Grid.Column="1" Style="{StaticResource RowCombo}">
                                        <ComboBoxItem Content="译文"/>
                                        <ComboBoxItem Content="罗马音"/>
                                        <ComboBoxItem Content="关闭"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="逐字歌词"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="卡拉 OK 逐字扫过效果（需要歌曲有逐字词源）"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="KaraokeSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="歌词偏移"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="单位秒，-3 ~ 3，歌词比人声慢就调大"/>
                                    </StackPanel>
                                    <TextBox x:Name="OffsetBox" Grid.Column="1" Width="72" HorizontalAlignment="Right"
                                             VerticalAlignment="Center" Text="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CardHeader}" Text="播放源"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="播放器来源"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="从哪些播放器获取播放状态"/>
                                    </StackPanel>
                                    <ComboBox x:Name="SourceCombo" Grid.Column="1" Style="{StaticResource RowCombo}">
                                        <ComboBoxItem Content="自动（优先网易云）"/>
                                        <ComboBoxItem Content="仅网易云音乐"/>
                                        <ComboBoxItem Content="仅其他播放器"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="屏蔽播放器"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="屏蔽后不再从该播放器获取播放状态（如浏览器）"/>
                                    </StackPanel>
                                    <Button x:Name="BlockButton" Grid.Column="1" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Padding="12,5" Click="BlockButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 外观 -->
                    <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageHeader}" Text="外观"/>
                        <TextBlock Style="{StaticResource CardHeader}" Text="文字"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="字体"/>
                                    </StackPanel>
                                    <ComboBox x:Name="FontCombo" Grid.Column="1" Style="{StaticResource RowCombo}"
                                              IsEditable="True"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="字号"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="8 ~ 24，译文自动小一号"/>
                                    </StackPanel>
                                    <TextBox x:Name="FontSizeBox" Grid.Column="1" Width="72" HorizontalAlignment="Right"
                                             VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="加粗原文"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="歌词第一行（原文）使用半粗体，任务栏上更清晰；译文保持常规"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="FontBoldSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="文字对齐"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="居中时以文字中心为锚，行宽变化不漂移"/>
                                    </StackPanel>
                                    <ComboBox x:Name="AlignCombo" Grid.Column="1" Style="{StaticResource RowCombo}">
                                        <ComboBoxItem Content="居中"/>
                                        <ComboBoxItem Content="左对齐（配封面更整齐）"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="文字颜色"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="跟随系统时：深色任务栏白字、浅色任务栏深字，切换主题自动跟上"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ColorModeCombo" Grid.Column="1" Style="{StaticResource RowCombo}"
                                              SelectionChanged="ColorModeCombo_SelectionChanged">
                                        <ComboBoxItem Content="跟随系统明暗"/>
                                        <ComboBoxItem Content="自定义"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="原文颜色"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="格式 #RRGGBB，或点右边的预设色"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button x:Name="TextChip1" Style="{StaticResource ColorChip}" Background="#FFFFFF"
                                                Tag="#FFFFFF" ToolTip="白（深色任务栏）" Click="ColorChip_Click"/>
                                        <Button x:Name="TextChip2" Style="{StaticResource ColorChip}" Background="#C8C8C8"
                                                Tag="#C8C8C8" ToolTip="浅灰" Click="ColorChip_Click"/>
                                        <Button x:Name="TextChip3" Style="{StaticResource ColorChip}" Background="#1A1A1A"
                                                Tag="#1A1A1A" ToolTip="近黑（浅色任务栏）" Click="ColorChip_Click"/>
                                        <Button x:Name="TextChip4" Style="{StaticResource ColorChip}" Background="#5A5A5A"
                                                Tag="#5A5A5A" ToolTip="中灰" Click="ColorChip_Click"/>
                                        <!-- 88 而不是 76：#RRGGBB 是 7 个字，但雅黑里 C/8 比 F 宽，
                                             76 下 #C8C8C8 最后一位会被裁掉，看着像填错了 -->
                                        <TextBox x:Name="TextColorBox" Width="88" Margin="4,0,0,0"
                                                 TextChanged="ColorBox_TextChanged"/>
                                        <Border x:Name="TextColorSwatch" Width="24" Height="18" Margin="8,0,0,0"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="4" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="译文颜色"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="格式 #RRGGBB，或点右边的预设色"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button x:Name="TransChip1" Style="{StaticResource ColorChip}" Background="#FFFFFF"
                                                Tag="#FFFFFF" ToolTip="白" Click="ColorChip_Click"/>
                                        <Button x:Name="TransChip2" Style="{StaticResource ColorChip}" Background="#C8C8C8"
                                                Tag="#C8C8C8" ToolTip="浅灰（深色任务栏）" Click="ColorChip_Click"/>
                                        <Button x:Name="TransChip3" Style="{StaticResource ColorChip}" Background="#1A1A1A"
                                                Tag="#1A1A1A" ToolTip="近黑" Click="ColorChip_Click"/>
                                        <Button x:Name="TransChip4" Style="{StaticResource ColorChip}" Background="#5A5A5A"
                                                Tag="#5A5A5A" ToolTip="中灰（浅色任务栏）" Click="ColorChip_Click"/>
                                        <TextBox x:Name="TransColorBox" Width="88" Margin="4,0,0,0"
                                                 TextChanged="ColorBox_TextChanged"/>
                                        <Border x:Name="TransColorSwatch" Width="24" Height="18" Margin="8,0,0,0"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="4" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="文字阴影"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="给笔画描一层反差色（深字配白影、浅字配黑影），压在花哨壁纸上也看得清"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="ShadowSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CardHeader}" Text="布局"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="专辑封面"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="在歌词左侧显示封面"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="ShowCoverSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="悬停控制按钮"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="鼠标悬停时显示播放/切歌按钮"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="ShowControlsSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="最大宽度"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="歌词区最大宽度（像素），超出部分横向滚动"/>
                                    </StackPanel>
                                    <ComboBox x:Name="WidthCombo" Grid.Column="1" Width="96" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" IsEditable="True">
                                        <ComboBoxItem Content="200"/>
                                        <ComboBoxItem Content="280"/>
                                        <ComboBoxItem Content="420"/>
                                        <ComboBoxItem Content="560"/>
                                        <ComboBoxItem Content="700"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 关于 -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageHeader}" Text="关于"/>
                        <Border Style="{StaticResource Card}">
                            <Grid Margin="16,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 徽标用 MDL2 字形而非位图：矢量、跟随主题明暗，也不必把 ico 打进资源 -->
                                <Border Width="52" Height="52" CornerRadius="10" VerticalAlignment="Top"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="&#xE189;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="任务栏歌词" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock x:Name="AboutVersionText" FontSize="12" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Style="{StaticResource RowDesc}" Margin="0,8,0,0"
                                               Text="把正在播放的歌词嵌进 Windows 任务栏的空白处，随可用空间伸缩、不与图标托盘重叠；也可切换为独立置顶浮窗。"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource CardHeader}" Text="链接"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="项目主页"/>
                                        <TextBlock Style="{StaticResource RowDesc}"
                                                   Text="github.com/ChissaQAQ/TaskbarLyrics"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="打开" Padding="12,5" VerticalAlignment="Center"
                                            Tag="https://github.com/ChissaQAQ/TaskbarLyrics" Click="Link_Click"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="反馈问题"/>
                                        <TextBlock Style="{StaticResource RowDesc}"
                                                   Text="歌词抓错、显示异常、崩溃日志都可以提 Issue"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="打开" Padding="12,5" VerticalAlignment="Center"
                                            Tag="https://github.com/ChissaQAQ/TaskbarLyrics/issues" Click="Link_Click"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="日志目录"/>
                                        <TextBlock Style="{StaticResource RowDesc}"
                                                   Text="异常会记到程序目录的 error.log，反馈时附上更好定位"/>
                                    </StackPanel>
                                    <Button x:Name="OpenLogDirButton" Grid.Column="1" Content="打开" Padding="12,5"
                                            VerticalAlignment="Center" Click="OpenLogDir_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource CardHeader}" Text="说明"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="16,14" >
                                <TextBlock Style="{StaticResource RowDesc}" TextWrapping="Wrap"
                                           Text="播放信息（歌名、歌手、进度）取自 Windows 自带的媒体传输控件（SMTC），因此理论上支持所有向系统上报播放状态的播放器，无需为某个客户端做适配。"/>
                                <TextBlock Style="{StaticResource RowDesc}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Text="歌词依次向网易云音乐、QQ 音乐、LRCLIB 查询，取第一个匹配上歌名与歌手的结果；译文与罗马音只有网易云提供，逐字歌词来自酷狗。歌词均为各平台用户上传，个别歌曲曲库里本身就没有或对不上时间轴，属于数据本身的上限。"/>
                                <TextBlock Style="{StaticResource RowDesc}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Text="「检查更新」查询 GitHub Releases 上的最新版本，发现新版后可一键下载并自动替换重启，配置与歌词缓存都会保留。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部按钮栏 -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Width="88" Margin="8,0,0,0" Click="Ok_Click" IsDefault="True"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        BorderThickness="0"/>
                <Button Content="应用" Width="88" Margin="8,0,0,0" Click="Apply_Click"/>
                <Button Content="取消" Width="88" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
