<Window x:Class="TaskbarLyrics.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务栏歌词 - 设置" Width="820" Height="660" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowTintBrush}"
        Topmost="True">
    <!-- Win11 设置风格：左侧导航 + 卡片式分组；行 = 标题+说明（左）/ 控件（右）。
         多选项统一用下拉框（不会再横向溢出），布尔项用开关（ToggleSwitch）。
         背景/控件样式交给 App.xaml 的 Fluent 主题（跟随系统明暗）；
         卡片/分隔线用「文字色 + 低透明度」的自适应画刷，明暗主题都成立。 -->
    <Window.Resources>
        <!-- 窗口底色微灰（亮）/ 微亮（暗），卡片用主题窗口色 → 明暗主题下卡片都清晰分层 -->
        <SolidColorBrush x:Key="WindowTintBrush" Opacity="0.035"
                         Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}"/>
        <SolidColorBrush x:Key="CardBorderBrush" Opacity="0.18"
                         Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}"/>
        <SolidColorBrush x:Key="SeparatorBrush" Opacity="0.14"
                         Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}"/>

        <!-- Win11 式开关：滑块位移动画 + 强调色轨道 -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X"
                                                             To="22" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Track" CornerRadius="11" BorderThickness="1"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0,0,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobX" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter TargetName="Track" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter TargetName="Knob" Property="Fill"
                                        Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片容器 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
        </Style>
        <!-- 设置行：左标题+说明，右控件 -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,9"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        </Style>
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource SeparatorBrush}"/>
        </Style>
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>
        <Style x:Key="PageHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,16"/>
        </Style>
        <Style x:Key="RowCombo" TargetType="ComboBox">
            <Setter Property="Width" Value="220"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Padding="8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="10,10,10,14">
                        <TextBlock Text="任务栏歌词" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="设置" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    </StackPanel>
                    <ListBox x:Name="NavList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,6">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Width="26" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="1" Width="1" Background="{StaticResource SeparatorBrush}"/>

            <!-- 内容页 -->
            <ScrollViewer x:Name="PageScroller" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Padding="28,18,28,8">
                <StackPanel>
                    <!-- 通用 -->
                    <StackPanel x:Name="PageGeneral" Visibility="Visible">
                        <TextBlock Style="{StaticResource PageHeader}" Text="通用"/>
                        <TextBlock Style="{StaticResource CardHeader}" Text="显示"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="显示模式"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="嵌入任务栏，或作为独立的置顶悬浮窗"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ModeCombo" Grid.Column="1" Style="{StaticResource RowCombo}">
                                        <ComboBoxItem Content="任务栏模式"/>
                                        <ComboBoxItem Content="浮动模式"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="显示器"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="在哪块屏幕的任务栏上显示歌词"/>
                                    </StackPanel>
                                    <ComboBox x:Name="MonitorCombo" Grid.Column="1" Style="{StaticResource RowCombo}"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="全屏时自动隐藏"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="全屏应用（如游戏）在前台且与歌词同屏时隐藏"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="HideFullscreenSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CardHeader}" Text="行为"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="锁定位置"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="锁定后鼠标穿透、不可拖动，可在托盘菜单解锁"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="LockedSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="开机自启"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="登录 Windows 后自动启动"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="AutostartSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 歌词 -->
                    <StackPanel x:Name="PageLyrics" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageHeader}" Text="歌词"/>
                        <TextBlock Style="{StaticResource CardHeader}" Text="内容"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="第二行"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="优先显示译文；无译文时自动显示下一句"/>
                                    </StackPanel>
                                    <ComboBox x:Name="SecondLineCombo" Grid.Column="1" Style="{StaticResource RowCombo}">
                                        <ComboBoxItem Content="译文"/>
                                        <ComboBoxItem Content="罗马音"/>
                                        <ComboBoxItem Content="关闭"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="逐字歌词"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="卡拉 OK 逐字扫过效果（需要歌曲有逐字词源）"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="KaraokeSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="歌词偏移"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="单位秒，-3 ~ 3，提前为负"/>
                                    </StackPanel>
                                    <TextBox x:Name="OffsetBox" Grid.Column="1" Width="72" HorizontalAlignment="Right"
                                             VerticalAlignment="Center" Text="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CardHeader}" Text="播放源"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="播放器来源"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="从哪些播放器获取播放状态"/>
                                    </StackPanel>
                                    <ComboBox x:Name="SourceCombo" Grid.Column="1" Style="{StaticResource RowCombo}">
                                        <ComboBoxItem Content="自动（优先网易云）"/>
                                        <ComboBoxItem Content="仅网易云音乐"/>
                                        <ComboBoxItem Content="仅其他播放器"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="屏蔽播放器"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="屏蔽后不再从该播放器获取播放状态（如浏览器）"/>
                                    </StackPanel>
                                    <Button x:Name="BlockButton" Grid.Column="1" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Padding="12,5" Click="BlockButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 外观 -->
                    <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageHeader}" Text="外观"/>
                        <TextBlock Style="{StaticResource CardHeader}" Text="文字"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="字体"/>
                                    </StackPanel>
                                    <ComboBox x:Name="FontCombo" Grid.Column="1" Style="{StaticResource RowCombo}"
                                              IsEditable="True"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="字号"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="8 ~ 24，译文自动小一号"/>
                                    </StackPanel>
                                    <TextBox x:Name="FontSizeBox" Grid.Column="1" Width="72" HorizontalAlignment="Right"
                                             VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="文字对齐"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="居中时以文字中心为锚，行宽变化不漂移"/>
                                    </StackPanel>
                                    <ComboBox x:Name="AlignCombo" Grid.Column="1" Style="{StaticResource RowCombo}">
                                        <ComboBoxItem Content="居中"/>
                                        <ComboBoxItem Content="左对齐（配封面更整齐）"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="原文颜色"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="格式 #RRGGBB"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBox x:Name="TextColorBox" Width="76" TextChanged="ColorBox_TextChanged"/>
                                        <Border x:Name="TextColorSwatch" Width="24" Height="18" Margin="8,0,0,0"
                                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                                CornerRadius="4" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="译文颜色"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="格式 #RRGGBB"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBox x:Name="TransColorBox" Width="76" TextChanged="ColorBox_TextChanged"/>
                                        <Border x:Name="TransColorSwatch" Width="24" Height="18" Margin="8,0,0,0"
                                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                                CornerRadius="4" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="文字阴影"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="深色投影，提升在浅色任务栏上的可读性"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="ShadowSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CardHeader}" Text="布局"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="专辑封面"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="在歌词左侧显示封面"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="ShowCoverSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="悬停控制按钮"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="鼠标悬停时显示播放/切歌按钮"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="ShowControlsSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="最大宽度"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Text="歌词区最大宽度（像素），超出部分横向滚动"/>
                                    </StackPanel>
                                    <ComboBox x:Name="WidthCombo" Grid.Column="1" Width="96" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" IsEditable="True">
                                        <ComboBoxItem Content="420"/>
                                        <ComboBoxItem Content="560"/>
                                        <ComboBoxItem Content="700"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部按钮栏 -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SeparatorBrush}"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Width="88" Margin="8,0,0,0" Click="Ok_Click" IsDefault="True"
                        Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                        Foreground="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        BorderThickness="0"/>
                <Button Content="应用" Width="88" Margin="8,0,0,0" Click="Apply_Click"/>
                <Button Content="取消" Width="88" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
